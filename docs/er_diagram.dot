digraph ERDiagram {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", label="Placement Management System - ER Diagram", labelloc=t, fontsize=22]
  node [shape=plain, fontname="Arial"]
  edge [color="#4b6178", fontname="Arial", fontsize=9]
  roles [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#e5efff"><TR><TD><B>roles</B></TD></TR><TR><TD ALIGN="LEFT">PK role_id</TD></TR><TR><TD ALIGN="LEFT">name UNIQUE</TD></TR></TABLE>>]
  users [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#e5efff"><TR><TD><B>users</B></TD></TR><TR><TD ALIGN="LEFT">PK user_id</TD></TR><TR><TD ALIGN="LEFT">FK role_id</TD></TR><TR><TD ALIGN="LEFT">email UNIQUE</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD></TR><TR><TD ALIGN="LEFT">full_name</TD></TR></TABLE>>]
  students [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#eaf7ea"><TR><TD><B>students</B></TD></TR><TR><TD ALIGN="LEFT">PK student_id</TD></TR><TR><TD ALIGN="LEFT">FK user_id UNIQUE</TD></TR><TR><TD ALIGN="LEFT">roll_number UNIQUE</TD></TR><TR><TD ALIGN="LEFT">department, cgpa</TD></TR></TABLE>>]
  companies [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#fff3dc"><TR><TD><B>companies</B></TD></TR><TR><TD ALIGN="LEFT">PK company_id</TD></TR><TR><TD ALIGN="LEFT">name UNIQUE</TD></TR><TR><TD ALIGN="LEFT">industry, website</TD></TR></TABLE>>]
  recruiters [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#fff3dc"><TR><TD><B>recruiters</B></TD></TR><TR><TD ALIGN="LEFT">PK recruiter_id</TD></TR><TR><TD ALIGN="LEFT">FK user_id UNIQUE</TD></TR><TR><TD ALIGN="LEFT">FK company_id</TD></TR></TABLE>>]
  jobs [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#ffe9f0"><TR><TD><B>job_postings</B></TD></TR><TR><TD ALIGN="LEFT">PK job_id</TD></TR><TR><TD ALIGN="LEFT">FK company_id</TD></TR><TR><TD ALIGN="LEFT">title, description</TD></TR><TR><TD ALIGN="LEFT">minimum_cgpa, deadline</TD></TR></TABLE>>]
  applications [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#ffe9f0"><TR><TD><B>applications</B></TD></TR><TR><TD ALIGN="LEFT">PK application_id</TD></TR><TR><TD ALIGN="LEFT">FK job_id, student_id</TD></TR><TR><TD ALIGN="LEFT">status, applied_at</TD></TR><TR><TD ALIGN="LEFT">UNIQUE job_id + student_id</TD></TR></TABLE>>]
  interviews [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#f0eaff"><TR><TD><B>interviews</B></TD></TR><TR><TD ALIGN="LEFT">PK interview_id</TD></TR><TR><TD ALIGN="LEFT">FK application_id</TD></TR><TR><TD ALIGN="LEFT">scheduled_at, mode, status</TD></TR></TABLE>>]
  feedback [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#f0eaff"><TR><TD><B>recruiter_feedback</B></TD></TR><TR><TD ALIGN="LEFT">PK feedback_id</TD></TR><TR><TD ALIGN="LEFT">FK application_id UNIQUE</TD></TR><TR><TD ALIGN="LEFT">rating, comments</TD></TR></TABLE>>]
  placements [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#eaf7ea"><TR><TD><B>placements</B></TD></TR><TR><TD ALIGN="LEFT">PK placement_id</TD></TR><TR><TD ALIGN="LEFT">FK application_id UNIQUE</TD></TR><TR><TD ALIGN="LEFT">placed_at, final_package_lpa</TD></TR></TABLE>>]
  roles -> users [label="1:N"]
  users -> students [label="1:0..1"]
  users -> recruiters [label="1:0..1"]
  companies -> recruiters [label="1:N"]
  companies -> jobs [label="1:N"]
  students -> applications [label="1:N"]
  jobs -> applications [label="1:N"]
  applications -> interviews [label="1:N"]
  applications -> feedback [label="1:0..1"]
  applications -> placements [label="1:0..1"]
}