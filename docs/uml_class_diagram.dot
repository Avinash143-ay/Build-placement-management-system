digraph UMLClassDiagram {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", label="Placement Management System - UML Class Diagram", labelloc=t, fontsize=22]
  node [shape=record, style="rounded,filled", fillcolor="#eef4ff", color="#345995", fontname="Arial", fontsize=10]
  edge [color="#506784", fontname="Arial", fontsize=9]
  User [label="{User|user_id: int\lemail: str\lfull_name: str\lrole: Role\l|login()\lissue_token()\l}"]
  Student [label="{Student|student_id: int\lroll_number: str\lcgpa: float\l|browse_jobs()\lapply(job_id)\lview_applications()\l}"]
  Recruiter [label="{Recruiter|recruiter_id: int\lcompany_id: int\l|create_job()\lupdate_application()\l}"]
  Company [label="{Company|company_id: int\lname: str\lindustry: str\l|list_jobs()\l}"]
  JobPosting [label="{JobPosting|job_id: int\ntitle: str\nminimum_cgpa: float\nstatus: str\n|is_open()\nmeets_eligibility(cgpa)\n}"]
  Application [label="{Application|application_id: int\nstatus: str\napplied_at: datetime\n|submit()\nchange_status()\n}"]
  Interview [label="{Interview|interview_id: int\nscheduled_at: datetime\nmode: str\n|schedule()\ncancel()\n}"]
  Placement [label="{Placement|placement_id: int\nplaced_at: date\nfinal_package_lpa: float\n|confirm()\n}"]
  PlacementAPI [label="{PlacementAPI|app: Flask\ndatabase: Database\n|login()\nlist_jobs()\napply()\nadmin_stats()\n}"]
  Database [label="{Database|driver: sqlite/mysql\nconnection\n|execute()\ncommit()\nclose()\n}"]
  BPlusTree [label="{BPlusTree|order: int\nroot: Node\n|insert()\nsearch()\nrange_query()\ndelete()\n}"]
  User -> Student [label="profile"]
  User -> Recruiter [label="profile"]
  Recruiter -> Company [label="works for"]
  Company -> JobPosting [label="publishes"]
  Student -> Application [label="submits"]
  JobPosting -> Application [label="receives"]
  Application -> Interview [label="may schedule"]
  Application -> Placement [label="may become"]
  PlacementAPI -> Database [label="uses"]
  PlacementAPI -> BPlusTree [label="benchmark uses"]
}